<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1200 630" width="1200" height="630">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#FAF8F3"/>
      <stop offset="50%" stop-color="#FFFDF7"/>
      <stop offset="100%" stop-color="#F4F0FA"/>
    </linearGradient>
    <linearGradient id="gold" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#DFCA9B"/>
      <stop offset="50%" stop-color="#C6A46C"/>
      <stop offset="100%" stop-color="#9A7B42"/>
    </linearGradient>
  </defs>
  <rect width="1200" height="630" fill="url(#bg)"/>
  <rect x="30" y="30" width="1140" height="570" fill="none" stroke="url(#gold)" stroke-width="2" rx="16"/>
  <rect x="45" y="45" width="1110" height="540" fill="none" stroke="#B8A4D8" stroke-width="1" stroke-dasharray="4 4" rx="12"/>
  
  <text x="600" y="160" font-family="'Amiri', serif" font-size="36" fill="#9A7B42" text-anchor="middle">بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ</text>
  <text x="600" y="215" font-family="'Inter', sans-serif" font-size="14" font-weight="600" fill="#5A5462" text-anchor="middle" letter-spacing="4">TOGETHER WITH THEIR FAMILIES</text>
  
  <text x="600" y="290" font-family="'Cormorant Garamond', Georgia, serif" font-size="52" font-weight="600" fill="#29252E" text-anchor="middle">Mizbha Tahereem Fatima</text>
  <text x="600" y="340" font-family="'Cormorant Garamond', Georgia, serif" font-size="28" font-style="italic" fill="#C6A46C" text-anchor="middle">weds</text>
  <text x="600" y="405" font-family="'Cormorant Garamond', Georgia, serif" font-size="52" font-weight="600" fill="#29252E" text-anchor="middle">Altamash Ali</text>
  
  <text x="600" y="480" font-family="'Inter', sans-serif" font-size="16" font-weight="500" fill="#5A5462" text-anchor="middle" letter-spacing="2">26 &amp; 27 NOVEMBER 2026 • GULBARGA, KARNATAKA</text>
  <text x="600" y="525" font-family="'Cormorant Garamond', Georgia, serif" font-size="22" font-style="italic" fill="#9A7B42" text-anchor="middle">M &amp; A</text>
